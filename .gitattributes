* text=auto eol=lf
# Large binary art assets go through Git LFS (run `git lfs install` once)
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
assets/textures/** filter=lfs diff=lfs merge=lfs -text
# Audio is small placeholder WAVs for now and lives in plain git.
# Move large recorded audio to LFS later (add *.wav / *.ogg lines here).
# The Quaternius characters (Increment 29) are small (about 10 MB) and live
# in plain git: LFS can't be uploaded to from where they were added.
assets/characters/** -filter -diff -merge
